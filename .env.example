# URL do feed do Waze for Cities: Traffic View (rotas) ou feed de trânsito (alertas + congestionamentos)
WAZE_TVT_FEED_URL=

# Opcional: outros feeds lidos junto, separados por vírgula (aqui: Ponte Rio-Niterói)
WAZE_TVT_FEED_URL_EXTRA=

# Opcional: webhook que recebe um POST JSON quando um alerta abre, escala ou encerra
ALERTA_WEBHOOK_URL=

# Opcionais: sobrepõem config/tuneis.yaml
# TUNEIS_CONFIG=config/tuneis.yaml
# TUNEIS_DB=data/tuneis.db
